# default R project things to ignore
.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

# ignore folders that may be generated by the targets package
_targets/

# keep job_outputs/ itself: sbatch --output and crew's log_directory both write here, and
# SLURM fails outright if the directory does not exist in a fresh clone
job_outputs/*
!job_outputs/.gitkeep

# ignore everything in trunk/ except the directory structure
trunk/*

!trunk/raw/
!trunk/derived/
!trunk/analysis/

trunk/raw/*
trunk/derived/*
trunk/analysis/*

!trunk/.gitkeep
!trunk/README.md
!trunk/raw/.gitkeep
!trunk/derived/.gitkeep
!trunk/analysis/.gitkeep
