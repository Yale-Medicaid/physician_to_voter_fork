# default R project things to ignore
.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

# ignore folders that may be generated by the targets package
_targets/
job_outputs/

# ignore everything in trunk/ except the directory structure
trunk/*

!trunk/raw/
!trunk/derived/
!trunk/analysis/

trunk/raw/*
trunk/derived/*
trunk/analysis/*

!trunk/.gitkeep
!trunk/README.md
!trunk/raw/.gitkeep
!trunk/derived/.gitkeep
!trunk/analysis/.gitkeep
